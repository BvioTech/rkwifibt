#!/usr/bin/make -f
# rkwifibt-dev-tools: BT attach tools (meson) + the AIC8800 wifi/bt runtime
# payload that the SDK's post-wifibt.sh used to drop into the rootfs (scripts,
# service, conf, sleep hooks). os-next does not run post-wifibt.sh, so the deb
# carries this so `apt install rkwifibt-dev-tools` yields a working setup.
# Kernel .ko + firmware are NOT here — they ship via the BSP (modules.tar.zst /
# firmware.tar.zst), same rkwifibt snapshot. See VENDOR.md.
#export DH_VERBOSE = 1

%:
	dh $@ --buildsystem=meson

override_dh_auto_install:
	dh_auto_install   # meson installs the 4 BT tools to /usr/bin
	D=debian/rkwifibt-dev-tools; \
	install -d $$D/etc $$D/usr/bin $$D/lib/systemd/system \
	          $$D/usr/lib/pm-utils/sleep.d $$D/lib/systemd/system-sleep; \
	install -m 0644 conf/* $$D/etc/; \
	install -m 0755 scripts/wifibt-init.sh scripts/wifibt-util.sh \
	                scripts/wifi-connect.sh scripts/wifi_ap6xxx_rftest.sh $$D/usr/bin/; \
	for b in bt-tty wifibt-info wifibt-vendor wifibt-id wifibt-bus wifibt-chip wifibt-module; do \
	    ln -sf wifibt-util.sh $$D/usr/bin/$$b; \
	done; \
	install -m 0644 wifibt-init.service $$D/lib/systemd/system/; \
	install -m 0755 scripts/wifibt-sleep-hook.sh $$D/usr/lib/pm-utils/sleep.d/; \
	install -m 0755 scripts/wifibt-sleep-hook.sh $$D/lib/systemd/system-sleep/
	# NOTE: bin/arm/* (dhd, wl, rtlbtmp, ...) intentionally excluded — armhf
	# 32-bit debug tools, optional (RK_ROOTFS_PREBUILT_TOOLS), not for arm64.

override_dh_installsystemd:
	dh_installsystemd --name=wifibt-init wifibt-init.service
